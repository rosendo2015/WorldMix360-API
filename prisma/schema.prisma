generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  customer
  admin
  sale
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  role      UserRole  @default(customer)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  blogPosts BlogPost[]

  @@map("users")
}

model MercadoLivreConnection {
  id           Int       @id @default(1)
  sellerId     String    @map("seller_id")
  accessToken  String    @map("access_token")
  refreshToken String    @map("refresh_token")
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime? @updatedAt @map("updated_at")

  @@map("mercado_livre_connection")
}

model Category {
  id            String        @id @default(uuid())
  name          String
  slug          String        @unique
  description   String?
  image         String?
  active        Boolean       @default(true)
  sortOrder     Int           @default(0) @map("sort_order")
  subcategories Subcategory[]
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([active])
  @@index([sortOrder])
  @@map("categories")
}

model Subcategory {
  id          String  @id @default(uuid())
  categoryId  String  @map("category_id")
  name        String
  slug        String
  description String?
  image       String?
  active      Boolean @default(true)
  sortOrder   Int     @default(0) @map("sort_order")

  category Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  products Product[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([active])
  @@index([sortOrder])
  @@map("subcategories")
}

model Marketplace {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  websiteUrl  String? @map("website_url")
  logoUrl     String? @map("logo_url")
  active      Boolean @default(true)
  sortOrder   Int     @default(0) @map("sort_order")

  products Product[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@index([active])
  @@index([sortOrder])
  @@map("marketplaces")
}

model Product {
  id               String    @id @default(uuid())
  externalId       String?   @map("external_id")
  title            String
  slug             String    @unique
  description      String?
  shortDescription String?   @map("short_description")
  imageUrl         String    @map("image_url")
  price            Decimal   @db.Decimal(12, 2)
  originalPrice    Decimal?  @map("original_price") @db.Decimal(12, 2)
  currency         String    @default("BRL")
  rating           Decimal?  @db.Decimal(3, 2)
  reviewsCount     Int       @default(0) @map("reviews_count")
  affiliateUrl     String    @map("affiliate_url")
  available        Boolean   @default(true)
  featured         Boolean   @default(false)
  active           Boolean   @default(true)
  seoTitle         String?   @map("seo_title")
  seoDescription   String?
  syncedAt         DateTime  @default(now()) @map("synced_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime? @updatedAt @map("updated_at")

  subcategoryId String      @map("subcategory_id")
  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)

  marketplaceId String      @map("marketplace_id")
  marketplace   Marketplace @relation(fields: [marketplaceId], references: [id], onDelete: Restrict)

  images ProductImage[]

  blogPostProducts BlogPostProduct[]

  @@unique([externalId, marketplaceId])
  @@index([subcategoryId])
  @@index([marketplaceId])
  @@index([available])
  @@index([active])
  @@index([featured])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl  String  @map("image_url")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@index([productId])
  @@index([sortOrder])
  @@map("product_images")
}

model BlogCategory {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  image       String?
  active      Boolean @default(true)
  sortOrder   Int     @default(0) @map("sort_order")

  posts BlogPost[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@index([active])
  @@index([sortOrder])
  @@map("blog_categories")
}

model BlogPost {
  id             String  @id @default(uuid())
  title          String
  slug           String  @unique
  excerpt        String?
  content        String
  coverImage     String? @map("cover_image")
  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description")

  status BlogPostStatus @default(DRAFT)

  publishedAt DateTime? @map("published_at")
  scheduledAt DateTime? @map("scheduled_at")

  authorId String @map("author_id")
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  categoryId String?       @map("category_id")
  category   BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  products BlogPostProduct[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@index([status])
  @@index([publishedAt])
  @@index([scheduledAt])
  @@index([authorId])
  @@index([categoryId])
  @@map("blog_posts")
}

model BlogPostProduct {
  id        String @id @default(uuid())
  postId    String @map("post_id")
  productId String @map("product_id")
  sortOrder Int    @default(0) @map("sort_order")

  post    BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([postId, productId])
  @@index([postId])
  @@index([productId])
  @@index([sortOrder])
  @@map("blog_post_products")
}
