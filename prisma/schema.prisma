generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  customer
  admin
  sale
}

model User {
  id       String   @id @default(uuid())
  name     String
  email    String   @unique
  password String
  role     UserRole @default(customer)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("users")
}

model MercadoLivreConnection {
  id           Int      @id @default(1)
  sellerId     String   @map("seller_id")
  accessToken  String   @map("access_token")
  refreshToken String   @map("refresh_token")
  expiresAt    DateTime @map("expires_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@map("mercado_livre_connection")
}

model Category {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  image       String?
  active      Boolean @default(true)
  sortOrder   Int     @default(0) @map("sort_order")

  subcategories Subcategory[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([active])
  @@index([sortOrder])
  @@map("categories")
}

model Subcategory {
  id          String  @id @default(uuid())
  categoryId  String  @map("category_id")
  name        String
  slug        String
  description String?
  image       String?
  active      Boolean @default(true)
  sortOrder   Int     @default(0) @map("sort_order")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  products Product[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([active])
  @@index([sortOrder])
  @@map("subcategories")
}

model Marketplace {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  websiteUrl  String? @map("website_url")
  logoUrl     String? @map("logo_url")
  active      Boolean @default(true)
  sortOrder   Int     @default(0) @map("sort_order")

  products Product[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([active])
  @@index([sortOrder])
  @@map("marketplaces")
}

model Product {
  id String @id @default(uuid())

  externalId String? @map("external_id")

  title String
  slug  String @unique

  description      String?
  shortDescription String? @map("short_description")

  imageUrl String @map("image_url")

  price         Decimal  @db.Decimal(12, 2)
  originalPrice Decimal? @map("original_price") @db.Decimal(12, 2)

  currency String @default("BRL")

  rating       Decimal? @db.Decimal(3, 2)
  reviewsCount Int      @default(0) @map("reviews_count")

  affiliateUrl String @map("affiliate_url")

  available Boolean @default(true)
  featured  Boolean @default(false)
  active    Boolean @default(true)

  seoTitle       String? @map("seo_title")
  seoDescription String?

  syncedAt DateTime @default(now()) @map("synced_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  subcategoryId String      @map("subcategory_id")
  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)

  marketplaceId String      @map("marketplace_id")
  marketplace   Marketplace @relation(fields: [marketplaceId], references: [id], onDelete: Restrict)

  @@unique([externalId, marketplaceId])
  @@index([subcategoryId])
  @@index([marketplaceId])
  @@index([available])
  @@index([active])
  @@index([featured])
  @@map("products")
}
